# GitHub
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
GITHUB_REPO_OWNER=your-org
GITHUB_REPO_NAME=your-repo

# Ollama (lightweight, tool-calling-capable model -- good fit for Apple Silicon)
OLLAMA_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434

# Safety switch: keep true until you've verified behavior. When true, GitHub write
# actions (PR comments, branch protection) and Slack/Discord notifications are only
# logged, never actually sent.
DRY_RUN=true

# Optional notification targets (only used when DRY_RUN=false)
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# Local event log + daily report time (24h, server-local time)
DB_PATH=./github_monitor.db
DAILY_REPORT_TIME=18:00
