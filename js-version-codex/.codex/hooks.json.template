{
  "hooks": {
    "SessionStart": [
      { "hooks": [
        { "type": "command", "command": "{{BASH}} \"{{PROJECT_DIR}}/hooks/log_hook.sh\" SessionStart" },
        { "type": "command", "command": "node \"{{PROJECT_DIR}}/hooks/anchor_hook.js\" SessionStart" }
      ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [
        { "type": "command", "command": "{{BASH}} \"{{PROJECT_DIR}}/hooks/log_hook.sh\" UserPromptSubmit" },
        { "type": "command", "command": "node \"{{PROJECT_DIR}}/hooks/anchor_hook.js\" UserPromptSubmit" }
      ] }
    ],
    "PreToolUse": [
      { "matcher": "*", "hooks": [
        { "type": "command", "command": "{{BASH}} \"{{PROJECT_DIR}}/hooks/log_hook.sh\" PreToolUse" },
        { "type": "command", "command": "node \"{{PROJECT_DIR}}/hooks/anchor_hook.js\" PreToolUse" }
      ] }
    ],
    "PermissionRequest": [
      { "matcher": "*", "hooks": [
        { "type": "command", "command": "{{BASH}} \"{{PROJECT_DIR}}/hooks/log_hook.sh\" PermissionRequest" }
      ] }
    ],
    "PostToolUse": [
      { "matcher": "*", "hooks": [
        { "type": "command", "command": "{{BASH}} \"{{PROJECT_DIR}}/hooks/log_hook.sh\" PostToolUse" },
        { "type": "command", "command": "node \"{{PROJECT_DIR}}/hooks/anchor_hook.js\" PostToolUse" }
      ] }
    ],
    "PreCompact": [
      { "matcher": "*", "hooks": [
        { "type": "command", "command": "{{BASH}} \"{{PROJECT_DIR}}/hooks/log_hook.sh\" PreCompact" }
      ] }
    ],
    "PostCompact": [
      { "matcher": "*", "hooks": [
        { "type": "command", "command": "{{BASH}} \"{{PROJECT_DIR}}/hooks/log_hook.sh\" PostCompact" }
      ] }
    ],
    "SubagentStart": [
      { "matcher": "*", "hooks": [
        { "type": "command", "command": "{{BASH}} \"{{PROJECT_DIR}}/hooks/log_hook.sh\" SubagentStart" },
        { "type": "command", "command": "node \"{{PROJECT_DIR}}/hooks/anchor_hook.js\" SubagentStart" }
      ] }
    ],
    "SubagentStop": [
      { "matcher": "*", "hooks": [
        { "type": "command", "command": "{{BASH}} \"{{PROJECT_DIR}}/hooks/log_hook.sh\" SubagentStop" }
      ] }
    ],
    "Stop": [
      { "hooks": [
        { "type": "command", "command": "{{BASH}} \"{{PROJECT_DIR}}/hooks/log_hook.sh\" Stop" },
        { "type": "command", "command": "node \"{{PROJECT_DIR}}/hooks/anchor_hook.js\" Stop" }
      ] }
    ]
  }
}
