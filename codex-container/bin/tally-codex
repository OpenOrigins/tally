#!/usr/bin/env bash
set -Eeuo pipefail

extra=()
case "${1:-}" in
  login|logout|help|--help|-h|--version|version)
    extra=()
    ;;
  *)
    if [ "${TALLY_BYPASS_HOOK_TRUST:-1}" = "1" ]; then
      extra+=(--dangerously-bypass-hook-trust)
    fi
    ;;
esac

if [ "${1:-}" = "exec" ] && [ "${TALLY_TEE_CODEX_STDIO:-1}" = "1" ]; then
  mkdir -p "$TALLY_LOG_ROOT/codex-stdio"
  stdout_log="$TALLY_LOG_ROOT/codex-stdio/${TALLY_RUN_ID}.stdout.log"
  stderr_log="$TALLY_LOG_ROOT/codex-stdio/${TALLY_RUN_ID}.stderr.log"
  exec codex "${extra[@]}" "$@" > >(tee -a "$stdout_log") 2> >(tee -a "$stderr_log" >&2)
fi

exec codex "${extra[@]}" "$@"
