          {
            "type": "command",
            "command": "/opt/tally-codex/bin/tally-codex hook SessionStart",
            "timeout": 15,
            "statusMessage": "Tally: recording Codex session start"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
