{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/tally-claude/bin/tally-claude hook SessionStart",
            "timeout": 15,
            "statusMessage": "Tally: recording Claude Code session start"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/tally-claude/bin/tally-claude hook UserPromptSubmit",
            "timeout": 15,
            "statusMessage": "Tally: recording user prompt"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
